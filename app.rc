#include <windows.h>
#include "resource.h"

LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT

IDI_APPICON ICON "app.ico"

IDD_FIND DIALOGEX 0, 0, 300, 86
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "찾기"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "찾을 내용(&N):", -1, 8, 11, 55, 9
    EDITTEXT        IDC_FIND_WHAT, 66, 9, 148, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "다음 찾기(&F)", IDC_FINDNEXT, 222, 8, 70, 15
    PUSHBUTTON      "취소", IDCANCEL, 222, 27, 70, 15
    AUTOCHECKBOX    "대/소문자 구분(&C)", IDC_MATCHCASE, 8, 32, 110, 10
    AUTOCHECKBOX    "되돌아 찾기(&W)", IDC_WRAPAROUND, 8, 46, 110, 10
    AUTOCHECKBOX    "모든 공간에서 찾기(&P)", IDC_ALLPANES, 8, 60, 120, 10
    GROUPBOX        "방향", -1, 130, 28, 84, 30
    AUTORADIOBUTTON "위로(&U)", IDC_DIR_UP, 136, 41, 36, 10, WS_GROUP
    AUTORADIOBUTTON "아래로(&D)", IDC_DIR_DOWN, 172, 41, 38, 10
END

IDD_REPLACE DIALOGEX 0, 0, 300, 90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "바꾸기"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "찾을 내용(&N):", -1, 8, 11, 55, 9
    EDITTEXT        IDC_FIND_WHAT, 66, 9, 148, 13, ES_AUTOHSCROLL
    LTEXT           "바꿀 내용(&P):", -1, 8, 30, 55, 9
    EDITTEXT        IDC_REPL_WITH, 66, 28, 148, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "다음 찾기(&F)", IDC_FINDNEXT, 222, 8, 70, 15
    PUSHBUTTON      "바꾸기(&R)", IDC_REPLACE1, 222, 27, 70, 15
    PUSHBUTTON      "모두 바꾸기(&A)", IDC_REPLACEALL, 222, 46, 70, 15
    PUSHBUTTON      "취소", IDCANCEL, 222, 65, 70, 15
    AUTOCHECKBOX    "대/소문자 구분(&C)", IDC_MATCHCASE, 8, 48, 110, 10
    AUTOCHECKBOX    "되돌아 찾기(&W)", IDC_WRAPAROUND, 8, 62, 110, 10
    AUTOCHECKBOX    "모든 공간에서 바꾸기(&L)", IDC_ALLPANES, 8, 76, 130, 10
END

IDD_GOTO DIALOGEX 0, 0, 148, 56
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "줄 이동"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "줄 번호(&L):", -1, 8, 11, 50, 9
    EDITTEXT        IDC_GOTO_LINE, 62, 9, 78, 13, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "이동(&G)", IDOK, 16, 33, 58, 15
    PUSHBUTTON      "취소", IDCANCEL, 82, 33, 58, 15
END

IDD_SETTINGS DIALOGEX 0, 0, 230, 104
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "설정"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "기본 인코딩(&E):", -1, 8, 12, 70, 9
    COMBOBOX        IDC_SET_ENC, 82, 10, 140, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "자동 줄 바꿈 기본값(&W)", IDC_SET_WRAP, 8, 34, 150, 10
    LTEXT           "글꼴:", -1, 8, 55, 30, 9
    LTEXT           "", IDC_SET_FONTNAME, 40, 55, 112, 9, SS_PATHELLIPSIS
    PUSHBUTTON      "변경(&F)...", IDC_SET_FONT, 160, 52, 62, 15
    DEFPUSHBUTTON   "확인", IDOK, 98, 81, 60, 15
    PUSHBUTTON      "취소", IDCANCEL, 162, 81, 60, 15
END
